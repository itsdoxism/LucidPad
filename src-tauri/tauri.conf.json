{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LucidPad",
  "version": "0.3.0",
  "identifier": "com.moroodol.lucidpad",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LucidPad",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#0b0b0b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JustDream-LoL/LucidPad/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NjcxRjhFQjkxM0NDNzYKUldSMnpCTzVqaDluYVkyNkk2VldIK2ROWmY2WVdVeTc2TU1KNVR3WmNzaGdqQlBCam5VRkVLYmoK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
